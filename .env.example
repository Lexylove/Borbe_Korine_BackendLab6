# Copy this file to .env or configure these variables in your hosting provider.
# Replace every placeholder with a real value. Never commit secrets.

# Application settings
APP_NAME=ProductManagementAPI
APP_ENV=development
APP_KEY=GENERATE_A_RANDOM_SECRET

# Aiven MySQL (Aiven Console -> your service -> Connection information)
DB_DRIVER=mysql
DB_HOST=YOUR_AIVEN_HOST
DB_PORT=YOUR_AIVEN_PORT
DB_USER=YOUR_AIVEN_USERNAME
DB_PASSWORD=YOUR_AIVEN_PASSWORD
DB_NAME=YOUR_AIVEN_DATABASE
DB_CHARSET=utf8mb4
DB_PREFIX=
DB_SSL=true
DB_SSL_CA=/etc/secrets/ca.pem

# Generate separate random secrets for both token keys.
JWT_SECRET=GENERATE_A_RANDOM_SECRET
REFRESH_TOKEN_KEY=GENERATE_A_DIFFERENT_RANDOM_SECRET

# Frontend origin(s) allowed by CORS (comma-separated if needed).
FRONTEND_ORIGIN=https://YOUR-FRONTEND.onrender.com

# Enable for local CLI migrations. Set false in Render production settings.
MIGRATION_ENABLED=true

# Initial admin account created by migration 004.
INITIAL_ADMIN_EMAIL=YOUR_ADMIN_EMAIL
INITIAL_ADMIN_PASSWORD=YOUR_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS
INITIAL_ADMIN_USERNAME=YOUR_ADMIN_USERNAME
