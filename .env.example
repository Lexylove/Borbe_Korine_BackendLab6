# Copy this file to .env and update the values below (NEVER commit .env)

# Application Settings
APP_NAME=ProductManagementAPI
APP_KEY=
APP_ENV=development

# Aiven MySQL  (Aiven Console -> your service -> Connection information)
DB_DRIVER=mysql
DB_HOST=your-service-name-your-project.a.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb
DB_CHARSET=utf8mb4
DB_PREFIX=

# Aiven requires TLS
DB_SSL=true
# Optional but recommended: paste the Aiven "CA certificate" on ONE line, newlines written as \n
# DB_SSL_CA_CONTENT=-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----
# or a file path instead:
# DB_SSL_CA=/path/to/ca.pem

# For API  (generate with: php lava jwt:generate --show)
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Frontend origin(s) allowed by CORS (comma separated)
FRONTEND_URL=http://localhost:5173

# Migrations (turn ON only on your own computer when running `php lava migration run`)
MIGRATION_ENABLED=true

# Default admin account created by migration 004
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
